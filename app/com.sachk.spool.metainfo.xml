    <category>Video</category>
  </categories>
  <url type="homepage">https://github.com/spool-player/spool</url>
  <developer id="io.github.spool-player">
    <name>Spool</name>
  </developer>
  <releases>
    <release version="0.9.0" date="2026-10-07">
      <description><p>Add a Stremio add-on provider with its own stream and torrent-file chooser using an external streaming server. Download original or server-converted media for offline playback, with platform-appropriate destination selection. Simplify settings sync to a recommended preset with one status and recovery screen. Add a global seek-preview switch and filtered provider logging. Remove synchronous mpv render waits from desktop fullscreen transitions. Bundle compatible Jellyfin, Emby, Plex and Stremio providers, with explicit Apple App Store inclusion policy. Retain automatic episode continuation, full-resolution GPU-scaled seek previews, Home watching-profile selection and native spoolet controls.</p></description>
    </release>
    <release version="0.8.11" date="2026-10-01">
      <description><p>Rearrange homepage libraries by dragging or with TV-remote move controls. Improve PIN, password and Quick Connect screens. Show clearer server labels and source icons, and deduplicate search results across servers. Bundle updated Jellyfin, Emby and Plex providers, which remain independently upgradable. Update FFmpeg to its security-fixed bugfix release.</p></description>
    </release>
    <release version="0.8.3" date="2026-09-29">
      <description><p>Install and update providers from the startup chooser with download progress, and enable optional provider features.</p></description>
    </release>
