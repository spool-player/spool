  <name>Spool</name>
  <summary>Fast media player for TVs and desktop</summary>
  <description>
    <p>Browse and play media from Jellyfin, Emby, Plex and more with a native mpv playback pipeline.</p>
  </description>
  <launchable type="desktop-id">com.sachk.spool.desktop</launchable>
