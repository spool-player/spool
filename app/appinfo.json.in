{
  "id": "com.sachk.spool",
  "version": "@VERSION@",
  "vendor": "Spool",
  "type": "native",
  "main": "bin/jellyfin-native",
  "title": "Spool for Jellyfin",
  "icon": "icon.png",
  "largeIcon": "large-icon.png",
  "splashBackground": "splash.png",
  "appDescription": "Very fast mpv-based Jellyfin client for LG webOS.",
  "tileSize": "normal",
  "supportTouchMode": "full",
  "spinnerOnLaunch": false,
  "visible": true,
  "removable": true,
  "inspectable": true,
  "transparent": false,
  "disableBackHistoryAPI": true,
  "handlesRelaunch": true,
  "requiredMemory": 300,
  "nativeLifeCycleInterfaceVersion": 2
}
