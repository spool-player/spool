+void QCocoaWindow::replayPendingFullScreenState()
+{
+    // A native titlebar transition has no pending Qt request. Do not undo it.
+    // A newer explicit request made during state delivery clears the pending
+    // state in setWindowState(), and must likewise not be overwritten here.
+    // Defer past AppKit's notification stack: calling toggleFullScreen:
+    // synchronously inside NSWindowDid{Enter,Exit}FullScreenNotification logs
+    // a transition error and drops the request on macOS 15+.
+    if (!m_pendingFullScreenState)
+        return;
+
+    const auto requestedState = *m_pendingFullScreenState;
+    const QPointer<QWindow> target(window());
+    QMetaObject::invokeMethod(
+        target,
+        [this, target, requestedState] {
+            if (!target || target->handle() != this)
+                return;
+            if (!m_pendingFullScreenState || *m_pendingFullScreenState != requestedState)
+                return;
+            m_pendingFullScreenState.reset();
+            target->setWindowStates(requestedState);
+        },
+        Qt::QueuedConnection);
+}
