 void QCocoaWindow::setWindowState(Qt::WindowStates state)
 {
+    if (window()->isVisible() && isTransitioningToFullScreen()) {
+        // qt_fullScreen is only set by NSWindowDidEnterFullScreenNotification.
+        // Until then, applying a normal state sees an already-normal window
+        // and loses the request. Keep only the latest explicit Qt request.
+        m_pendingFullScreenState = state;
+        return;
+    }
+
+    m_pendingFullScreenState.reset();
     if (window()->isVisible())
         applyWindowState(state); // Window state set for hidden windows take effect when show() is called
 }
@@ -955,6 +964,15 @@
     setWindowFlags(window()->flags());
 
     handleWindowStateChanged();
+
+    // A native titlebar entry has no pending Qt request. Do not undo it.
+    // A newer explicit request made during state delivery clears the pending
+    // state in setWindowState(), and must likewise not be overwritten here.
+    if (m_pendingFullScreenState) {
+        const auto requestedState = *m_pendingFullScreenState;
+        m_pendingFullScreenState.reset();
+        window()->setWindowStates(requestedState);
+    }
