# Initial cache, loaded AFTER the dependency/linkage selectors. Platform wrappers
# own compilers, sysroots, OpenSSL, install prefixes and architecture arguments.
if(NOT STREAMING_DEPENDENCY MATCHES "^(nghttp2|nghttp3|ngtcp2|curl)$")
    message(FATAL_ERROR "STREAMING_DEPENDENCY must be nghttp2, nghttp3, ngtcp2 or curl")
endif()
if(NOT DEFINED STREAMING_SHARED)
    message(FATAL_ERROR "STREAMING_SHARED must be specified")
endif()
function(streaming_bool key value)
    set(${key} ${value} CACHE BOOL "Spool transport closure" FORCE)
endfunction()
if(STREAMING_SHARED)
    set(streaming_static OFF)
else()
    set(streaming_static ON)
endif()
streaming_bool(BUILD_SHARED_LIBS ${STREAMING_SHARED})
streaming_bool(BUILD_STATIC_LIBS ${streaming_static})
streaming_bool(BUILD_TESTING OFF)
streaming_bool(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_INSTALL_LIBDIR lib CACHE STRING "Spool transport library directory" FORCE)
if(STREAMING_DEPENDENCY STREQUAL "nghttp2")
    streaming_bool(ENABLE_LIB_ONLY ON)
    streaming_bool(ENABLE_DOC OFF)
    streaming_bool(ENABLE_APP OFF)
elseif(STREAMING_DEPENDENCY MATCHES "^(nghttp3|ngtcp2)$")
    streaming_bool(ENABLE_SHARED_LIB ${STREAMING_SHARED})
    streaming_bool(ENABLE_STATIC_LIB ${streaming_static})
    streaming_bool(ENABLE_LIB_ONLY ON)
    streaming_bool(ENABLE_DOC OFF)
    if(STREAMING_DEPENDENCY STREQUAL "ngtcp2")
        streaming_bool(ENABLE_OPENSSL ON)
        foreach(adapter BORINGSSL LIBRESSL PICOTLS WOLFSSL GNUTLS QUICTLS)
            streaming_bool(ENABLE_${adapter} OFF)
        endforeach()
    endif()
else()
    foreach(feature BUILD_CURL_EXE BUILD_LIBCURL_DOCS BUILD_MISC_DOCS BUILD_EXAMPLES
            CURL_BROTLI CURL_ZSTD CURL_USE_GSSAPI CURL_USE_LIBPSL CURL_USE_LIBSSH2
            ENABLE_ARES ENABLE_CURL_MANUAL USE_LIBIDN2)
        streaming_bool(${feature} OFF)
    endforeach()
    foreach(protocol DICT DOH FILE FTP GOPHER HSTS IMAP IPFS LDAP LDAPS MQTT NETRC
            POP3 RTSP SMB SMTP TELNET TFTP WEBSOCKETS)
        streaming_bool(CURL_DISABLE_${protocol} ON)
    endforeach()
    streaming_bool(CURL_USE_OPENSSL ON)
    # Curl disables pkg-config by default on Android and Apple mobile targets.
    # Every wrapper supplies an isolated target-only pkg-config directory;
    # use it so the NDK/SDK find-root rules do not hide the installed closure.
    streaming_bool(CURL_USE_PKGCONFIG ON)
    foreach(dependency NGHTTP2 NGHTTP3 NGTCP2)
        streaming_bool(${dependency}_USE_STATIC_LIBS ${streaming_static})
    endforeach()
    streaming_bool(USE_NGHTTP2 ON)
    streaming_bool(USE_NGHTTP3 ON)
    streaming_bool(USE_NGTCP2 ON)
    streaming_bool(CURL_DISABLE_ALTSVC OFF)
    streaming_bool(ENABLE_THREADED_RESOLVER ON)
endif()
